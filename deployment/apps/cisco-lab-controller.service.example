# Prepared only. Never enable this while the Teacher controller timer is active.
[Unit]
Description=CISCO-LAB registered client controller on APP
ConditionHost=apps
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cisco-lab
Group=cisco-lab
WorkingDirectory=/opt/cisco-lab
Environment=HOME=/var/lib/cisco-lab
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ANSIBLE_HOME=/var/lib/cisco-lab/.ansible
Environment=ANSIBLE_LOCAL_TEMP=/var/lib/cisco-lab/.ansible/tmp
Environment=ANSIBLE_COLLECTIONS_PATH=/opt/cisco-lab/collections
ExecStart=/opt/cisco-lab/.venv/bin/python -B -m maintenance.controller --controller-host apps
UMask=0077
TimeoutStartSec=infinity
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/cisco-lab
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=203.0.113.0/24
MemoryMax=1G
CPUQuota=100%
TasksMax=128
LimitNOFILE=4096
