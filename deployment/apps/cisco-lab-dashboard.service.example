# Prepared only. Install and enable after the APP pilot and backup checks pass.
[Unit]
Description=CISCO-LAB dashboard on APP
ConditionHost=apps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cisco-lab
Group=cisco-lab
WorkingDirectory=/opt/cisco-lab
Environment=HOME=/var/lib/cisco-lab
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ANSIBLE_HOME=/var/lib/cisco-lab/.ansible
Environment=ANSIBLE_LOCAL_TEMP=/var/lib/cisco-lab/.ansible/tmp
Environment=ANSIBLE_COLLECTIONS_PATH=/opt/cisco-lab/collections
ExecStart=/opt/cisco-lab/.venv/bin/python -B -m dashboard.server --state-dir /var/lib/cisco-lab/.local/state/cisco-lab-dashboard --report /var/lib/cisco-lab/maintenance-report.json --port 8765 --https-host lab-app.example.org --base-path /cisco-lab --backup-profile apps
UMask=0077
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/cisco-lab
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=203.0.113.0/24
MemoryMax=4G
CPUQuota=200%
TasksMax=512
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
